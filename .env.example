# ============================================================
# EduExam Pro - Bien moi truong
# Copy file nay thanh .env roi dien gia tri that.
# TUYET DOI khong commit file .env len Git.
# ============================================================

NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# ---------- API ----------
API_PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root_doi_mat_khau_nay
MYSQL_DATABASE=eduexam
MYSQL_USER=eduexam
MYSQL_PASSWORD=doi_mat_khau_nay
MYSQL_PORT=3306
DATABASE_URL="mysql://eduexam:doi_mat_khau_nay@localhost:3306/eduexam"

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# Sinh khoa: openssl rand -base64 48
JWT_ACCESS_SECRET=thay_bang_chuoi_ngau_nhien_dai
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_khac
JWT_REFRESH_TTL=7d

# ---------- MinIO / S3 (anh cau hoi, anh bang chung) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_QUESTION=eduexam-questions
S3_BUCKET_EVIDENCE=eduexam-evidence
MINIO_CONSOLE_PORT=9001

# ---------- Giam sat hanh vi thi ----------
# Chu ky client gom su kien va gui len server (ms)
PROCTOR_BATCH_INTERVAL_MS=5000
# So ngay luu anh bang chung truoc khi tu dong xoa (Nghi dinh 13/2023)
PROCTOR_EVIDENCE_RETENTION_DAYS=30

# ---------- Pandoc (import cau hoi tu Word) ----------
PANDOC_BIN=pandoc
PANDOC_TIMEOUT_MS=30000

# ---------- MySQL portable (chay khong can Docker) ----------
# Duong dan thu muc giai nen MySQL 8; dung cho npm run mysql:start
MYSQL_HOME=E:/mysql8/mysql-8.0.43-winx64
MYSQL_INI=E:/mysql8/my.ini
